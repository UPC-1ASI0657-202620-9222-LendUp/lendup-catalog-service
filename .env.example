DB_HOST=127.0.0.1
DB_PORT=3308
DB_NAME=lendup_catalogo
DB_USERNAME=lendup_catalogo
DB_PASSWORD=replace-with-local-password
MYSQL_ROOT_PASSWORD=replace-with-different-root-password
SERVER_PORT=8082
REDIS_ENABLED=true
REDIS_CONNECTION=127.0.0.1:6379,abortConnect=false,connectTimeout=500,syncTimeout=500,asyncTimeout=500
REDIS_TTL_SECONDS=60
CATALOGO_FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
IDENTITY_BASE_URL=http://localhost:8081
CORS_ORIGINS=http://localhost:5173
CLOUDINARY_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
OPENAPI_ENABLED=true

# Only Reservations can authenticate to the private snapshot API; inject from secrets in AWS.
CATALOG_RESERVATIONS_SERVICE_TOKEN=
