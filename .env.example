# Copia este archivo a .env y reemplaza estos valores. NUNCA subas .env a Git.
# Se utilizan solo para el servidor MySQL de desarrollo en Docker Compose.
DB_USERNAME=lendup_catalogo
DB_PASSWORD=replace-with-strong-local-password
MYSQL_ROOT_PASSWORD=replace-with-another-strong-root-password

# Cloudinary: configurar las variables de entorno localmente; no guardarlas en Git.
# CLOUDINARY_ENABLED=false
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret
